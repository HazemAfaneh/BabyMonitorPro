<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- LAN only: the app talks to devices on the same WiFi, never to the internet. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- mDNS discovery needs multicast on some devices. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- Camera role only; the viewer role needs neither. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- The watching half: it plays the nursery's audio, so mediaPlayback is the honest
         type. Without a service of its own a backgrounded viewer was frozen by the system,
         which cut the stream and stopped every alert. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 16 Live Updates: without this the broadcasting/watching notification still
         posts, but never gets the status-bar chip or the top-of-shade slot. -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Asked for from the settings screen, never silently. Without the exemption the system
         throttles this app in Doze and in app-standby, which is the difference between a
         monitor that runs all night and one that quietly stops at 3am. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <!-- A television has no touchscreen and no leanback-only requirement: this same APK is
         the phone build, the tablet build and the TV build. Both have to be declared
         not-required or the Play-style installers refuse the install on a TV outright. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:name=".BabyMonitorApp"
        android:allowBackup="true"
        android:banner="@drawable/tv_banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity
            android:exported="true"
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- The TV home row. Without this the app installs on Android TV and then
                 cannot be started from the launcher at all — there is no icon, and the only
                 way in is a file manager or adb. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>

            <!-- bmpro://<ip>:<port> from a scanned QR code. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="bmpro" />
            </intent-filter>
        </activity>

        <!-- Keeps the stream and the alerts alive while the watching device is in another
             app or its screen is off. -->
        <service
            android:name="com.hazemafaneh.babymonitorpro.client.ViewingService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Keeps capture alive while the camera phone's screen is off. -->
        <service
            android:name="com.hazemafaneh.babymonitorpro.server.BroadcastService"
            android:exported="false"
            android:foregroundServiceType="camera|microphone" />
    </application>

</manifest>
