<?xml version="1.0" encoding="utf-8"?>
<!--
  The Android TV home-row banner: 320x180, drawn rather than shipped as a PNG so it scales
  to whatever density the panel reports and costs nothing in the APK.

  The launcher draws it at about 5% of the screen width, so it carries the mark and the name
  and nothing else - a banner with a tagline on it is a banner nobody can read from a sofa.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFF6EFE2" />
        </shape>
    </item>
    <item
        android:gravity="center"
        android:width="96dp"
        android:height="96dp"
        android:drawable="@drawable/ic_launcher_foreground" />
</layer-list>
