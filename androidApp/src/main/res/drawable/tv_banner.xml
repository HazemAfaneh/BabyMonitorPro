<?xml version="1.0" encoding="utf-8"?>
<!--
  The Android TV home-row banner, 320x180.

  Drawn rather than shipped as a PNG so it scales to whatever density the panel reports. The
  launcher draws it small and from across a room, so it carries the mark alone — a banner with
  a tagline on it is a banner nobody can read from a sofa.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFFD84D" />
        </shape>
    </item>
    <item
        android:gravity="center"
        android:width="96dp"
        android:height="96dp"
        android:drawable="@drawable/ic_launcher_foreground" />
</layer-list>
